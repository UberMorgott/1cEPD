# Доступ к партнёрскому API 1С (portal.1c.ru -> Администрирование -> API к Порталу 1С:ИТС)
PARTNER_API_LOGIN=api-login-00000
PARTNER_API_PASSWORD=
PARTNER_CODE=00000

# Вход в наш сервис. Пароль задаётся одним из двух способов.
#
# Проще: написать пароль как есть, тем же, что вводится на сайте. Плата за
# удобство небольшая, но она есть — пароль лежит в файле открытым, и любой,
# кто получит .env, получит и вход.
#
# Надёжнее: хранить только хеш, файл тогда пароля не содержит.
# Хеш получить: go run ./cmd/hashpw "пароль"
#
# Если заданы оба, побеждает APP_PASSWORD_HASH, а в лог уходит предупреждение.
APP_LOGIN=admin
APP_PASSWORD=
APP_PASSWORD_HASH=

SESSION_TTL=12h
DB_PATH=./data/app.db
LISTEN_ADDR=127.0.0.1:8080

# Только для локального запуска по http. В проде за TLS-прокси оставить пустым или true:
# браузер не сохраняет cookie с флагом Secure на незащищённом соединении.
COOKIE_SECURE=true
