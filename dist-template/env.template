# ---------------------------------------------------------------------------
# Настройки Пульта ЭПД. Обычный текстовый файл, правится Блокнотом.
# После правки перезапустите программу: правая кнопка по значку у часов ->
# «Выход», затем снова start.bat.
# ---------------------------------------------------------------------------

# Вход на сайт. Что написано здесь — то и вводится в браузере.
APP_LOGIN=test
APP_PASSWORD=test12345

# Доступ к партнёрскому API 1С.
# portal.1c.ru -> Администрирование -> API к Порталу 1С:ИТС
# Пока здесь CHANGE_ME, программа работает, но реестр остаётся пустым.
PARTNER_API_LOGIN=CHANGE_ME
PARTNER_API_PASSWORD=CHANGE_ME
PARTNER_CODE=CHANGE_ME

SESSION_TTL=720h
DB_PATH=./data/app.db
LISTEN_ADDR=127.0.0.1:8123

# Запуск по обычному http, без сертификата: браузер не сохранит cookie с
# флагом Secure на незащищённом соединении, поэтому здесь false.
COOKIE_SECURE=false
